<idea-plugin>
    <id>com.bracketbow</id>
    <name>Bracketbow</name>
    <vendor email="hakangunay@gmail.com" url="https://github.com/hgunay/bracketbow">Hakan Gunay</vendor>

    <description><![CDATA[
        <p>Colors brackets <code>( )</code>, <code>[ ]</code>, <code>{ }</code> by nesting depth —
        a free, open-source alternative to Rainbow Brackets.</p>
        <p>Supports Java, Kotlin, XML, HTML, and JSON out of the box.</p>
        <ul>
            <li>7 color levels with full customization via <b>Settings &rarr; Editor &rarr; Color Scheme &rarr; Bracketbow</b></li>
            <li>Per-language and per-bracket-type toggles via <b>Settings &rarr; Tools &rarr; Bracketbow</b></li>
            <li>Changes apply instantly — no need to reopen files</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li><b>0.1.0</b> — Initial release. Bracket colorization for Java, Kotlin, XML, HTML, JSON.</li>
        </ul>
    ]]></change-notes>

    <!-- Platform her IntelliJ tabanlı IDE'de mevcuttur -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Java desteği opsiyonel; sadece Java modülü yüklüyse aktif olur -->
    <depends optional="true" config-file="bracketbow-java.xml">com.intellij.java</depends>

    <!-- Kotlin desteği opsiyonel -->
    <depends optional="true" config-file="bracketbow-kotlin.xml">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Ayarlar servisi (proje başına) -->
        <projectService serviceImplementation="com.bracketbow.settings.BracketbowSettings"/>

        <!-- Settings → Tools → Bracketbow sayfası -->
        <projectConfigurable
            parentId="tools"
            instance="com.bracketbow.settings.BracketbowConfigurable"
            id="com.bracketbow.settings"
            displayName="Bracketbow"
            nonDefaultProject="false"/>
        <!-- Her zaman mevcut diller için annotator kayıtları -->
        <annotator language="XML"
                   implementationClass="com.bracketbow.annotator.BracketbowAnnotator"/>
        <annotator language="HTML"
                   implementationClass="com.bracketbow.annotator.BracketbowAnnotator"/>
        <annotator language="JSON"
                   implementationClass="com.bracketbow.annotator.BracketbowAnnotator"/>

        <!-- Renk ayarları sayfası -->
        <colorSettingsPage
            implementation="com.bracketbow.colors.BracketbowColorSettingsPage"/>

        <!-- Varsayılan renkler -->
        <additionalTextAttributes scheme="Default"
                                  file="colorSchemes/BracketbowDefault.xml"/>
        <additionalTextAttributes scheme="Darcula"
                                  file="colorSchemes/BracketbowDarcula.xml"/>
    </extensions>

    <extensions defaultExtensionNs=org.jetbrains.kotlin>
        <!-- K1 ve K2 Kotlin plugin modlarının ikisini de destekliyoruz.
             Bracketbow yalnızca PSI ağacını okur; Kotlin analiz API'sine bağımlı değil. -->
        <supportsKotlinPluginMode supportsK1=true supportsK2=true/>
    </extensions>
</idea-plugin>
